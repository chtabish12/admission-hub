// Prisma schema for AdmissionHub
// PostgreSQL — works locally and on serverless hosts like Vercel.
// Lists are stored as JSON strings to keep the seed/query code portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT | CONSULTANT | ADMIN | UNIVERSITY

  fieldOfInterest  String?
  preferredCountry String?
  preferredCity    String?
  educationLevel   String?
  cgpa             Float?
  budget           Int?
  ieltsScore       Float?
  toeflScore       Int?
  workExperience   Int?
  careerGoals      String?
  preferredIntake  String?

  universityId String?
  university   University? @relation("UniversityStaff", fields: [universityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepProgress   StepProgress[]
  savedUnis      SavedUniversity[]
  consultant     Consultant?
  applications   Application[]
  documents      Document[]
  sentMessages   Message[]
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  name       String
  type       String
  url        String
  status     String   @default("pending")
  version    Int      @default(1)
  expiryDate String?
  uploadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id            String   @id @default(cuid())
  applicationId String
  senderId      String
  content       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model University {
  id             String  @id @default(cuid())
  name           String
  country        String
  city           String
  ranking        Int?
  description    String
  fields         String  // JSON array of field names
  tuitionMin     Int
  tuitionMax     Int
  currency       String  @default("USD")
  acceptanceRate Int? // percentage
  website        String?
  imageUrl       String?
  requirements   String  // JSON array
  applicationSteps String // JSON array of { title, description }
  deadlines      String?  // JSON array of { term, date }

  saved        SavedUniversity[]
  courseGuides CourseGuide[]
  staff        User[]        @relation("UniversityStaff")
  applications Application[]
}

model Application {
  id           String @id @default(cuid())
  studentId    String
  universityId String
  course       String
  status       String @default("new")
  priority     String @default("medium")
  intake       String?

  fullName      String
  email         String
  phone         String?
  nationality   String?
  educationLevel String?
  gpa           String?
  englishTest   String?
  statement     String
  documents     String  @default("[]")
  universityNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  events     ApplicationEvent[]
  messages   Message[]
  requirements ApplicationRequirement[]

  @@unique([studentId, universityId, course])
}

model ApplicationRequirement {
  id            String   @id @default(cuid())
  applicationId String
  title         String
  status        String   @default("pending")
  documentName  String?
  documentUrl   String?
  note          String?
  createdBy     String   @default("SYSTEM")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  message       String
  actor         String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// Per-course (program) admission data for a university: course-specific fees,
// requirements, application steps and deadlines. Generated on demand and cached.
model CourseGuide {
  id               String  @id @default(cuid())
  universityId     String
  course           String
  tuitionMin       Int
  tuitionMax       Int
  currency         String  @default("USD")
  requirements     String  // JSON array of strings
  applicationSteps String  // JSON array of { title, description }
  deadlines        String? // JSON array of { term, date }
  notes            String?
  source           String  @default("AI")
  createdAt        DateTime @default(now())

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, course])
}

model Consultant {
  id          String  @id @default(cuid())
  name        String
  email       String?
  company     String?
  country     String
  city        String
  specialties String  // JSON array (e.g. countries / fields they cover)
  fields      String  // JSON array
  bio         String
  rating      Float   @default(4.5)
  reviews     Int     @default(0)
  approved    Boolean @default(false)
  source      String  @default("PLATFORM") // PLATFORM | GOOGLE
  website     String?
  phone       String?
  imageUrl    String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model StepProgress {
  id        String   @id @default(cuid())
  userId    String
  stepKey   String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepKey])
}

model SavedUniversity {
  id           String   @id @default(cuid())
  userId       String
  universityId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId])
}
